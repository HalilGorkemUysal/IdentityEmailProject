@model MessageLayoutHeaderViewModel

@functions {
    // 2026-11-20 14:55 -> "5 dakika önce", "Dün, 22:14", "18 Kas, 09:30"
    string TimeAgo(DateTime date)
    {
        var diff = DateTime.Now - date;
        if (diff.TotalMinutes < 1) return "Az önce";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} dakika önce";
        if (diff.TotalHours < 24 && date.Date == DateTime.Today) return $"{(int)diff.TotalHours} saat önce";
        if (date.Date == DateTime.Today.AddDays(-1)) return $"Dün, {date:HH:mm}";
        return date.ToString("dd MMM, HH:mm", new System.Globalization.CultureInfo("tr-TR"));
    }
}

<header class="app-navbar">
    <button class="nav-toggle" id="sidebarToggle" type="button" aria-label="Menüyü daralt / genişlet" title="Menüyü daralt"><i class="bi bi-list"></i></button>

    <div class="global-search">
        <i class="bi bi-search"></i>
        <input type="search" id="globalSearch" placeholder="Mesajlarda, kişilerde ara…" autocomplete="off">
        <span class="kbd">Ctrl K</span>
    </div>

    <div class="nav-actions">
        <button class="icon-btn hide-xs" type="button" title="Yardım"><i class="bi bi-question-circle"></i></button>

        <!-- BİLDİRİMLER: okunmamış mesajlar -->
        <div class="dropdown">
            <button class="icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Bildirimler">
                <i class="bi bi-bell"></i>
                @if (Model.UnreadCount > 0)
                {
                    <span class="pip"></span>
                }
            </button>
            <div class="dropdown-menu dropdown-menu-end notif-menu">
                <div class="d-flex justify-content-between align-items-center px-2 pt-1 pb-2">
                    <strong style="font-size:14px">Bildirimler</strong>
                    @if (Model.UnreadCount > 0)
                    {
                        <span class="tag tag-is">@Model.UnreadCount yeni</span>
                    }
                </div>

                @if (Model.Notifications.Any())
                {
                    @foreach (var n in Model.Notifications)
                    {
                        <a class="notif-item" asp-controller="Message" asp-action="Inbox" style="text-decoration:none;color:inherit">
                            <div class="ni av-lav"><i class="bi bi-envelope"></i></div>
                            <div style="min-width:0">
                                <div class="nt">@n.SenderEmail size mesaj gönderdi</div>
                                <div class="nd">@n.Subject · @TimeAgo(n.SendDate)</div>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div class="px-2 py-3 text-center" style="font-size:13px;color:var(--muted)">
                        <i class="bi bi-bell-slash"></i> Yeni bildiriminiz yok
                    </div>
                }
            </div>
        </div>

        <!-- KULLANICI MENÜSÜ -->
        <div class="dropdown">
            <button class="user-chip" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="avatar sm av-user">@Model.Initials</span>
                <span class="meta">
                    <span class="name d-block">@Model.FullName</span>
                    <span class="role d-block">@Model.RoleName</span>
                </span>
                <i class="bi bi-chevron-down"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li class="dd-head">
                    <span class="avatar av-user">@Model.Initials</span>
                    <div style="min-width:0">
                        <div style="font-weight:700">@Model.FullName</div>
                        <div style="font-size:12.5px;color:var(--muted)">@Model.Email</div>
                    </div>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person"></i> Profilim</a></li>
                <li><a class="dropdown-item" asp-controller="UserSettings" asp-action="Index"><i class="bi bi-gear"></i> Ayarlar</a></li>
                <li><a class="dropdown-item" href="#" onclick="showToast('Tema seçenekleri yakında eklenecek.','bi-palette');return false;"><i class="bi bi-moon-stars"></i> Görünüm</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <!-- Çıkış POST ile yapılır: bir link ya da resim etiketiyle kullanıcı istemeden çıkarılamasın -->
                    <form asp-controller="Login" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="dropdown-item danger"><i class="bi bi-box-arrow-right"></i> Çıkış Yap</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</header>
