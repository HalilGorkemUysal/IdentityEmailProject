@model List<Message>
@{
    Layout = null;
}


<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container">
    <br />
    <br />
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Gönderici Mail</th>
                <th>Konu</th>
                <th>Tarih</th>
                <th>Mesajı Aç</th>
            </tr>
        </thead>
       
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MessageId</td>
                    <td>@item.SenderEmail</td>
                    <td>@item.Subject</td>
                    <td>@item.SendDate</td>
                    <td><a href="#" class="btn btn-success">Mesajı Aç</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

