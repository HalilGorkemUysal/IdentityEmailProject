@model List<Message>
@using System.Globalization
@using System.Text.RegularExpressions
@{
    ViewData["Title"] = "Çöp Kutusu";
    ViewData["ActiveMenu"] = "trash";
    Layout = "~/Views/MessageLayout/Index.cshtml";

    var box = ViewBag.Box as string ?? "received";
    var isSent = box == "sent";
}
@functions {
    static readonly CultureInfo Tr = new("tr-TR");

    static string Initials(string? s) =>
        string.IsNullOrWhiteSpace(s) ? "?" : s.Trim()[..1].ToUpper(Tr);

    static string Snippet(string? text, int max = 140)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        var t = Regex.Replace(text, @"\s+", " ").Trim();
        return t.Length > max ? t[..max].TrimEnd() + "…" : t;
    }
}

<section class="inbox">
    <div class="panel list-panel">
        <div class="list-head">
            <div class="list-title">
                <div>
                    <h1>Çöp Kutusu</h1>
                    <div class="sub">Buradan silinen mesajlara bir daha ulaşılamaz.</div>
                </div>
                @if (Model.Any())
                {
                    <form asp-controller="Message" asp-action="EmptyTrash" asp-route-box="@box" method="post"
                          onsubmit="return confirm('Bu sekmedeki tüm mesajlar kalıcı olarak silinecek. Emin misiniz?');">
                        <button type="submit" class="chip" style="color:#dc6478">
                            <i class="bi bi-trash3"></i> Bu Sekmeyi Boşalt
                        </button>
                    </form>
                }
            </div>

            <div class="list-tools">
                <div class="filter-chips">
                    <a class="chip @(!isSent ? "active" : "")" style="text-decoration:none"
                       asp-controller="Message" asp-action="Trash" asp-route-box="received">
                        <i class="bi bi-inbox"></i> Alınan <span class="n">@ViewBag.ReceivedCount</span>
                    </a>
                    <a class="chip @(isSent ? "active" : "")" style="text-decoration:none"
                       asp-controller="Message" asp-action="Trash" asp-route-box="sent">
                        <i class="bi bi-send"></i> Gönderilen <span class="n">@ViewBag.SentCount</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="msg-list">
            @foreach (var m in Model)
            {
                var person = isSent ? m.ReceiverEmail : m.SenderEmail;

                <article class="msg-item" style="cursor:default">
                    <div class="lead"></div>
                    <span class="avatar av-lav">@Initials(person)</span>
                    <div class="mi-sender"><span class="sender">@(isSent ? "Kime: " : "")@person</span></div>
                    <div class="mi-main">
                        <span class="subject">@m.Subject</span>
                        <span class="snippet">@Snippet(m.MessageDetail)</span>
                    </div>
                    <div style="display:flex;gap:6px;align-items:center">
                        <form asp-controller="Message" asp-action="RestoreMessage"
                              asp-route-id="@m.MessageId" asp-route-box="@box" method="post">
                            <button type="submit" class="chip" title="@(isSent ? "Gönderilenler'e geri taşı" : "Gelen Kutusu'na geri taşı")">
                                <i class="bi bi-arrow-counterclockwise"></i> Kurtar
                            </button>
                        </form>
                        <form asp-controller="Message" asp-action="PurgeMessage"
                              asp-route-id="@m.MessageId" asp-route-box="@box" method="post"
                              onsubmit="return confirm('Bu mesaj kalıcı olarak silinecek. Emin misiniz?');">
                            <button type="submit" class="chip" style="color:#dc6478" title="Tamamen sil">
                                <i class="bi bi-x-lg"></i> Tamamen Sil
                            </button>
                        </form>
                    </div>
                </article>
            }

            @if (!Model.Any())
            {
                <div class="empty-list">
                    <div class="ic"><i class="bi bi-trash3"></i></div>
                    <h6>Bu sekmede mesaj yok</h6>
                    <div>Sildiğiniz mesajlar burada görünür.</div>
                </div>
            }
        </div>
    </div>
</section>