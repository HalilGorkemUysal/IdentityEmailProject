@{
    Layout = null;
    ViewData["Title"] = "Şifre Sıfırlama Başarılı - Mailora";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            font-family: 'DM Sans', sans-serif;
            background: linear-gradient( 125deg, #f0edff 0%, #fafbff 48%, #eaf3ff 100% );
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 25px;
            color: #30334d;
        }

        .success-card {
            position: relative;
            width: 100%;
            max-width: 550px;
            padding: 55px 45px;
            background: #fff;
            border-radius: 30px;
            text-align: center;
            box-shadow: 0 24px 80px rgba(68,61,131,.12);
            overflow: hidden;
            animation: fadeIn .6s ease;
        }

            .success-card::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 6px;
                background: linear-gradient( 90deg, #9184e9, #7163d3, #4dbb9e );
            }

        /* LOGO */

        .brand-logo {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            margin-bottom: 45px;
        }

        .logo-icon {
            width: 49px;
            height: 49px;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient( 135deg, #a39af0, #7063ce );
            color: white;
            font-size: 24px;
            border-radius: 15px;
            box-shadow: 0 9px 20px rgba(103,84,205,.23);
        }

        .logo-text {
            font-size: 27px;
            font-weight: 800;
            letter-spacing: -1px;
        }

            .logo-text span {
                color: #8174df;
            }

        /* BAŞARI İKONU */

        .success-icon-wrap {
            position: relative;
            width: 135px;
            height: 135px;
            margin: 0 auto 32px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .success-circle {
            width: 115px;
            height: 115px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e9faf3;
            color: #43b48c;
            border-radius: 50%;
            font-size: 58px;
            animation: popIn .6s ease;
        }

        .success-ring {
            position: absolute;
            inset: 0;
            border: 2px solid #d7f4e7;
            border-radius: 50%;
        }

        /* MESAJ */

        .success-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 16px;
            background: #eaf9f3;
            color: #3da782;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 22px;
        }

        h1 {
            font-size: 32px;
            font-weight: 800;
            letter-spacing: -1.2px;
            line-height: 1.25;
            margin-bottom: 17px;
        }

        .description {
            color: #858aa2;
            font-size: 15px;
            line-height: 1.9;
            margin-bottom: 30px;
        }

        .info-box {
            background: #f6f4ff;
            border: 1px solid #e8e3ff;
            border-radius: 15px;
            padding: 18px;
            margin-bottom: 32px;
            color: #7669d4;
            font-size: 13px;
            line-height: 1.7;
        }

            .info-box i {
                margin-right: 7px;
                font-size: 16px;
            }

        /* GİRİŞ BUTONU */

        .login-btn {
            width: 100%;
            min-height: 56px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 11px;
            background: linear-gradient( 100deg, #9184e9, #7163d3 );
            color: white;
            text-decoration: none;
            font-size: 15px;
            font-weight: 700;
            border-radius: 15px;
            box-shadow: 0 12px 25px rgba(113,99,211,.23);
            transition: .2s ease;
        }

            .login-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 16px 30px rgba(113,99,211,.30);
                color: white;
            }

        .footer-note {
            margin-top: 29px;
            color: #959ab0;
            font-size: 12px;
        }

            .footer-note i {
                color: #4dbb9e;
                margin-right: 5px;
            }

        /* ANİMASYONLAR */

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(18px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes popIn {
            0% {
                opacity: 0;
                transform: scale(.5);
            }

            70% {
                transform: scale(1.1);
            }

            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* MOBİL */

        @@media (max-width: 600px) {
            .success-card {
                padding: 40px 25px;
                border-radius: 24px;
            }

            h1 {
                font-size: 26px;
            }

            .description {
                font-size: 14px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .success-card,
            .success-circle {
                animation: none;
            }

            .login-btn {
                transition: none;
            }
        }
    </style>
</head>

<body>

    <main class="success-card">

        <!-- MAILORA LOGO -->
        <div class="brand-logo">

            <div class="logo-icon">
                <i class="bi bi-envelope-paper-heart"></i>
            </div>

            <div class="logo-text">
                Mail<span>ora</span>
            </div>

        </div>

        <!-- BAŞARI İKONU -->
        <div class="success-icon-wrap">

            <div class="success-ring"></div>

            <div class="success-circle">
                <i class="bi bi-check-circle-fill"></i>
            </div>

        </div>

        <!-- BAŞARI MESAJI -->
        <div class="success-badge">
            <i class="bi bi-check-circle-fill"></i>
            İşlem Başarılı
        </div>

        <h1>
            Şifreniz Başarıyla
            Sıfırlanmıştır!
        </h1>

        <p class="description">
            Mailora hesabınızın şifresi başarıyla güncellendi.
            Artık yeni belirlediğiniz şifrenizle
            hesabınıza güvenle giriş yapabilirsiniz.
        </p>

        <div class="info-box">
            <i class="bi bi-shield-check"></i>
            Yeni şifreniz aktif hale getirildi.
            Hesabınıza giriş yapmak için aşağıdaki
            butona tıklayabilirsiniz.
        </div>

        <!-- LOGIN YÖNLENDİRME -->
        <a asp-controller="Login"
           asp-action="SignIn"
           class="login-btn">

            <i class="bi bi-box-arrow-in-right"></i>
            Giriş Yap
            <i class="bi bi-arrow-right"></i>

        </a>

        <div class="footer-note">
            <i class="bi bi-shield-check"></i>
            Mailora Güvenli Hesap Yönetimi
        </div>

    </main>

</body>
</html>
