@model ForgetPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Şifremi Unuttum - Mailora";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Şifremi Unuttum | Mailora</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <style>
        :root {
            --primary: #8174df;
            --primary-dark: #6859cb;
            --text: #30334d;
            --muted: #898fa8;
            --border: #e7e8f5;
            --input-bg: #f8f9fe;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            min-height: 100vh;
            background: linear-gradient( 125deg, #f0edff 0%, #fafbff 48%, #eaf3ff 100% );
            color: var(--text);
        }

        .auth-page {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 45px 20px;
        }

        .auth-card {
            width: 100%;
            max-width: 1150px;
            min-height: 650px;
            display: grid;
            grid-template-columns: 48% 52%;
            background: white;
            border-radius: 34px;
            overflow: hidden;
            box-shadow: 0 24px 80px rgba(68, 61, 131, .12);
        }

        /* SOL MARKA PANELİ */

        .brand-side {
            position: relative;
            padding: 48px 45px;
            background: linear-gradient( 155deg, #eae8ff, #e7ecff 58%, #e2f6fa );
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

            .brand-side::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image: radial-gradient( rgba(255,255,255,.95) 1.7px, transparent 1.7px );
                background-size: 27px 27px;
                pointer-events: none;
            }

            .brand-side > * {
                position: relative;
                z-index: 1;
            }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 27px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .logo-icon {
            width: 49px;
            height: 49px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #a39af0, #7063ce);
            color: white;
            border-radius: 15px;
            box-shadow: 0 9px 20px rgba(103,84,205,.23);
            font-size: 25px;
        }

        .brand-logo .accent {
            color: #8274df;
        }

        .brand-content {
            margin-top: 70px;
        }

        .brand-pill {
            display: inline-flex;
            gap: 8px;
            align-items: center;
            padding: 10px 17px;
            border-radius: 30px;
            color: #7867d7;
            background: rgba(255,255,255,.8);
            font-size: 13px;
            font-weight: 700;
        }

        .brand-content h1 {
            margin-top: 23px;
            font-size: clamp(29px, 3vw, 39px);
            letter-spacing: -1.6px;
            line-height: 1.17;
            font-weight: 800;
        }

            .brand-content h1 span {
                color: #8b7cdd;
            }

        .brand-content p {
            margin-top: 18px;
            color: #777d98;
            font-size: 15px;
            line-height: 1.8;
        }

        /* ZARF İLLÜSTRASYONU */

        .mail-illustration {
            position: relative;
            width: 290px;
            height: 205px;
            margin: 45px auto 25px;
        }

        .mail-paper {
            position: absolute;
            width: 150px;
            height: 117px;
            top: 7px;
            left: 70px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(95,84,155,.12);
            transform: rotate(-4deg);
            padding: 20px;
        }

            .mail-paper span {
                display: block;
                height: 8px;
                border-radius: 5px;
                margin-bottom: 12px;
                background: #e9e5fa;
            }

                .mail-paper span:first-child {
                    width: 55%;
                    background: #d6cdf8;
                }

        .mail-envelope {
            position: absolute;
            bottom: 0;
            left: 45px;
            width: 200px;
            height: 120px;
            background: linear-gradient(135deg,#a89af0,#8174d5);
            border-radius: 14px 14px 20px 20px;
            box-shadow: 0 20px 35px rgba(99,78,183,.19);
            overflow: hidden;
        }

            .mail-envelope::after {
                content: "";
                position: absolute;
                left: 0;
                bottom: 0;
                border-left: 100px solid transparent;
                border-right: 100px solid transparent;
                border-bottom: 68px solid #8c7fdb;
            }

        .floating-check {
            position: absolute;
            top: 45px;
            right: -5px;
            display: flex;
            align-items: center;
            gap: 10px;
            background: white;
            border-radius: 15px;
            padding: 12px 15px;
            box-shadow: 0 10px 30px rgba(90,85,150,.10);
            font-size: 12px;
            font-weight: 700;
            color: #68718f;
        }

            .floating-check i {
                color: #8174df;
                font-size: 22px;
            }

        .brand-bottom {
            margin-top: auto;
            display: flex;
            flex-direction: column;
            gap: 20px;
            padding-top: 30px;
        }

        .brand-feature {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .feature-icon {
            width: 39px;
            height: 39px;
            flex-shrink: 0;
            border-radius: 12px;
            background: rgba(255,255,255,.8);
            color: #8275df;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .brand-feature strong {
            display: block;
            font-size: 13px;
        }

        .brand-feature small {
            color: #8389a1;
            font-size: 12px;
        }

        /* SAĞ FORM */

        .form-side {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 55px 62px;
        }

        .form-content {
            width: 100%;
            max-width: 420px;
        }

        .reset-icon {
            width: 64px;
            height: 64px;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #f2efff;
            color: var(--primary);
            font-size: 29px;
            border-radius: 20px;
            margin-bottom: 25px;
        }

        .form-header h2 {
            font-size: 35px;
            font-weight: 800;
            letter-spacing: -1.3px;
        }

        .form-header p {
            margin-top: 12px;
            color: var(--muted);
            font-size: 15px;
            line-height: 1.8;
        }

        .reset-form {
            margin-top: 35px;
        }

        .field {
            margin-bottom: 26px;
        }

            .field label {
                display: block;
                margin-bottom: 11px;
                font-size: 14px;
                font-weight: 700;
                color: #555a73;
            }

        .required {
            color: #e17ba2;
        }

        .input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 18px;
            color: #a2a6be;
            font-size: 19px;
        }

        .form-input {
            width: 100%;
            height: 56px;
            padding: 0 18px 0 50px;
            font-family: inherit;
            font-size: 14px;
            background: var(--input-bg);
            border: 1.5px solid var(--border);
            border-radius: 15px;
            outline: none;
            color: var(--text);
            transition: .2s ease;
        }

            .form-input::placeholder {
                color: #a6abc0;
            }

            .form-input:focus {
                background: white;
                border-color: #988be8;
                box-shadow: 0 0 0 4px rgba(129,116,223,.10);
            }

        .submit-btn {
            width: 100%;
            height: 56px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            border: none;
            border-radius: 15px;
            background: linear-gradient(100deg,#9184e9,#7163d3);
            color: white;
            font-family: inherit;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 12px 25px rgba(113,99,211,.23);
            transition: .2s ease;
        }

            .submit-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 16px 30px rgba(113,99,211,.30);
            }

            .submit-btn:disabled {
                opacity: .7;
                cursor: wait;
            }

        .back-section {
            margin-top: 32px;
            padding-top: 27px;
            border-top: 1px solid #ececf5;
            text-align: center;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            text-decoration: none;
            color: var(--primary);
            font-size: 14px;
            font-weight: 700;
        }

            .back-link:hover {
                color: var(--primary-dark);
            }

        .secure-note {
            margin-top: 23px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            color: #959ab0;
            font-size: 12px;
            text-align: center;
        }

            .secure-note i {
                font-size: 17px;
                color: #4dbb9e;
            }

        .field-error {
            display: block;
            color: #d94b70;
            font-size: 12px;
            margin-top: 7px;
        }

        .validation-summary {
            color: #d94b70;
            font-size: 13px;
            margin-bottom: 20px;
        }

            .validation-summary ul {
                padding-left: 18px;
            }

        .success-message {
            padding: 18px;
            background: #effaf5;
            border: 1px solid #c9edda;
            border-radius: 15px;
            color: #318568;
            font-size: 14px;
            line-height: 1.7;
            margin-top: 25px;
        }

            .success-message i {
                margin-right: 6px;
            }

        /* MOBİL UYUM */

        @@media(max-width: 960px) {
            .auth-card {
                grid-template-columns: 42% 58%;
            }

            .brand-side {
                padding: 38px 28px;
            }

            .form-side {
                padding: 40px 35px;
            }

            .brand-content {
                margin-top: 55px;
            }
        }

        @@media(max-width: 720px) {
            .auth-page {
                padding: 18px 12px;
            }

            .auth-card {
                grid-template-columns: 1fr;
                border-radius: 24px;
            }

            .brand-side {
                padding: 25px;
            }

            .brand-content {
                margin-top: 24px;
            }

                .brand-content h1 {
                    font-size: 26px;
                }

            .mail-illustration,
            .brand-bottom {
                display: none;
            }

            .form-side {
                padding: 35px 25px 42px;
            }

            .form-header h2 {
                font-size: 30px;
            }
        }
    </style>
</head>

<body>

    <main class="auth-page">
        <div class="auth-card">

            <!-- SOL MARKA PANELİ -->
            <aside class="brand-side">

                <div class="brand-logo">
                    <span class="logo-icon">
                        <i class="bi bi-envelope-paper-heart"></i>
                    </span>

                    <span>Mail<span class="accent">ora</span></span>
                </div>

                <div class="brand-content">

                    <div class="brand-pill">
                        <i class="bi bi-shield-lock"></i>
                        Güvenli hesap kurtarma
                    </div>

                    <h1>
                        Hesabına yeniden
                        <span>kavuş.</span>
                    </h1>

                    <p>
                        Şifreni unutmuş olabilirsin, sorun değil!
                        Mailora hesabına yeniden erişmen için
                        sana yardımcı olacağız.
                    </p>
                </div>

                <!-- E-POSTA İLLÜSTRASYONU -->
                <div class="mail-illustration"
                     aria-hidden="true">

                    <div class="mail-paper">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>

                    <div class="mail-envelope"></div>

                    <div class="floating-check">
                        <i class="bi bi-envelope-check"></i>
                        <span>Güvenli sıfırlama</span>
                    </div>
                </div>

                <div class="brand-bottom">

                    <div class="brand-feature">
                        <div class="feature-icon">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <div>
                            <strong>E-posta doğrulaması</strong>
                            <small>Hesabın sana ait olduğunu doğrula.</small>
                        </div>
                    </div>

                    <div class="brand-feature">
                        <div class="feature-icon">
                            <i class="bi bi-key"></i>
                        </div>
                        <div>
                            <strong>Yeni şifre oluştur</strong>
                            <small>Hesabını güvenle geri kazan.</small>
                        </div>
                    </div>

                    <div class="brand-feature">
                        <div class="feature-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div>
                            <strong>Güvenli işlem</strong>
                            <small>Hesap güvenliğin önceliğimiz.</small>
                        </div>
                    </div>

                </div>
            </aside>

            <!-- SAĞ FORM -->
            <section class="form-side">

                <div class="form-content">

                    <div class="reset-icon">
                        <i class="bi bi-key"></i>
                    </div>

                    <div class="form-header">
                        <h2>Şifremi Unuttum</h2>
                        <p>
                            Mailora hesabına kayıtlı e-posta
                            adresini gir. Şifreni sıfırlaman
                            için sana bir bağlantı gönderelim.
                        </p>
                    </div>

                    @if (ViewBag.SuccessMessage != null)
                    {
                        <div class="success-message" role="status">
                            <i class="bi bi-check-circle-fill"></i>
                            @ViewBag.SuccessMessage
                        </div>
                    }
                    else
                    {
                        <form asp-controller="PasswordChange"
                              asp-action="ForgetPassword"
                              method="post"
                              class="reset-form"
                              id="resetForm">

                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly"
                                 class="validation-summary"
                                 role="alert"></div>

                            <div class="field">

                                <label asp-for="Email">
                                    E-posta Adresi
                                    <span class="required">*</span>
                                </label>

                                <div class="input-wrap">

                                    <i class="bi bi-envelope input-icon"></i>

                                    <input asp-for="Email"
                                           type="email"
                                           class="form-input"
                                           placeholder="ad.soyad@ornek.com"
                                           autocomplete="email"
                                           maxlength="254"
                                           required />

                                </div>

                                <span asp-validation-for="Email"
                                      class="field-error"></span>
                            </div>

                            <button type="submit"
                                    class="submit-btn"
                                    id="resetBtn">

                                <span>Sıfırlama Bağlantısı Gönder</span>
                                <i class="bi bi-arrow-right"></i>

                            </button>

                            <div class="secure-note">
                                <i class="bi bi-shield-check"></i>
                                Hesap kurtarma işlemleri güvenli şekilde gerçekleştirilir.
                            </div>

                        </form>
                    }

                    <div class="back-section">
                        <a asp-controller="Login"
                           asp-action="SignIn"
                           class="back-link">

                            <i class="bi bi-arrow-left"></i>
                            Giriş Sayfasına Dön

                        </a>
                    </div>

                </div>

            </section>
        </div>
    </main>

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const form = document.getElementById("resetForm");
            const btn = document.getElementById("resetBtn");

            if (!form || !btn) return;

            form.addEventListener("submit", function(event) {

                if (!form.checkValidity()) return;

                setTimeout(function() {
                    if (event.defaultPrevented) return;

                    btn.disabled = true;
                    btn.innerHTML =
                        '<i class="bi bi-arrow-repeat"></i> Gönderiliyor...';
                }, 0);

            });
        });
    </script>

</body>
</html>
