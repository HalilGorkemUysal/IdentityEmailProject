@model ResetPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Yeni Şifre Oluştur - Mailora";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <style>
        :root {
            --primary: #8174df;
            --primary-dark: #6859cb;
            --text: #30334d;
            --muted: #898fa8;
            --border: #e7e8f5;
            --input-bg: #f8f9fe;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            min-height: 100vh;
            color: var(--text);
            background: linear-gradient( 125deg, #f0edff, #fafbff 48%, #eaf3ff );
        }

        .auth-page {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 45px 20px;
        }

        .auth-card {
            width: 100%;
            max-width: 1150px;
            min-height: 690px;
            display: grid;
            grid-template-columns: 48% 52%;
            background: #fff;
            border-radius: 34px;
            overflow: hidden;
            box-shadow: 0 24px 80px rgba(68,61,131,.12);
        }

        /* SOL MARKA ALANI */

        .brand-side {
            position: relative;
            padding: 48px 45px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: linear-gradient( 155deg, #eae8ff, #e7ecff 58%, #e2f6fa );
        }

            .brand-side::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image: radial-gradient( rgba(255,255,255,.95) 1.7px, transparent 1.7px );
                background-size: 27px 27px;
                pointer-events: none;
            }

            .brand-side > * {
                position: relative;
                z-index: 1;
            }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 27px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .logo-icon {
            width: 49px;
            height: 49px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 15px;
            background: linear-gradient(135deg,#a39af0,#7063ce);
            color: white;
            font-size: 25px;
            box-shadow: 0 9px 20px rgba(103,84,205,.23);
        }

        .accent {
            color: #8274df;
        }

        .brand-content {
            margin-top: 75px;
        }

        .brand-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 17px;
            border-radius: 30px;
            background: rgba(255,255,255,.8);
            color: #7867d7;
            font-size: 13px;
            font-weight: 700;
        }

        .brand-content h1 {
            margin-top: 24px;
            font-size: clamp(29px,3vw,39px);
            letter-spacing: -1.6px;
            line-height: 1.18;
            font-weight: 800;
        }

            .brand-content h1 span {
                color: #8b7cdd;
            }

        .brand-content p {
            margin-top: 19px;
            color: #777d98;
            font-size: 15px;
            line-height: 1.8;
        }

        .illustration {
            position: relative;
            width: 235px;
            height: 200px;
            margin: 48px auto 30px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .shield-circle {
            width: 170px;
            height: 170px;
            border-radius: 42px;
            background: linear-gradient(135deg,#aba0ee,#8273d8);
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-size: 85px;
            transform: rotate(-8deg);
            box-shadow: 0 25px 45px rgba(99,78,183,.20);
        }

            .shield-circle i {
                transform: rotate(8deg);
            }

        .floating-check {
            position: absolute;
            right: -15px;
            bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 13px;
            background: white;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(90,85,150,.12);
            font-size: 12px;
            font-weight: 700;
            color: #68718f;
        }

            .floating-check i {
                color: #4dbb9e;
                font-size: 23px;
            }

        .brand-bottom {
            margin-top: auto;
            display: flex;
            flex-direction: column;
            gap: 20px;
            padding-top: 25px;
        }

        .brand-feature {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .feature-icon {
            width: 39px;
            height: 39px;
            flex-shrink: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 12px;
            background: rgba(255,255,255,.8);
            color: #8275df;
            font-size: 18px;
        }

        .brand-feature strong {
            display: block;
            font-size: 13px;
        }

        .brand-feature small {
            color: #8389a1;
            font-size: 12px;
        }

        /* SAĞ FORM ALANI */

        .form-side {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 55px 62px;
        }

        .form-content {
            width: 100%;
            max-width: 420px;
        }

        .reset-icon {
            width: 64px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 20px;
            background: #f2efff;
            color: var(--primary);
            font-size: 29px;
            margin-bottom: 25px;
        }

        .form-header h2 {
            font-size: 35px;
            font-weight: 800;
            letter-spacing: -1.3px;
        }

        .form-header p {
            margin-top: 12px;
            color: var(--muted);
            font-size: 15px;
            line-height: 1.8;
        }

        .reset-form {
            margin-top: 35px;
        }

        .field {
            margin-bottom: 25px;
        }

            .field label {
                display: block;
                margin-bottom: 11px;
                font-size: 14px;
                font-weight: 700;
                color: #555a73;
            }

        .required {
            color: #e17ba2;
        }

        .input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 18px;
            color: #a2a6be;
            font-size: 19px;
        }

        .form-input {
            width: 100%;
            height: 56px;
            padding: 0 50px;
            border: 1.5px solid var(--border);
            border-radius: 15px;
            background: var(--input-bg);
            color: var(--text);
            font: inherit;
            font-size: 14px;
            outline: none;
            transition: .2s ease;
        }

            .form-input::placeholder {
                color: #a6abc0;
            }

            .form-input:focus {
                background: white;
                border-color: #988be8;
                box-shadow: 0 0 0 4px rgba(129,116,223,.10);
            }

        .eye-btn {
            position: absolute;
            right: 16px;
            padding: 6px;
            border: none;
            background: transparent;
            color: #9399b0;
            font-size: 19px;
            cursor: pointer;
        }

            .eye-btn:hover {
                color: var(--primary);
            }

        /* ŞİFRE GÜCÜ */

        .strength-bars {
            display: flex;
            gap: 6px;
            margin-top: 12px;
        }

            .strength-bars span {
                flex: 1;
                height: 5px;
                background: #ececf6;
                border-radius: 10px;
                transition: .25s;
            }

        .strength-label {
            margin-top: 9px;
            display: flex;
            justify-content: space-between;
            color: #858aa2;
            font-size: 12px;
        }

            .strength-label b {
                color: #8174df;
            }

        .password-rules {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 18px;
            color: #979bb2;
            font-size: 12px;
        }

            .password-rules div {
                display: flex;
                align-items: center;
                gap: 7px;
            }

            .password-rules .valid {
                color: #3eaa87;
            }

        .match-text {
            display: block;
            margin-top: 9px;
            color: #d94b70;
            font-size: 12px;
        }

            .match-text.success {
                color: #3eaa87;
            }

        .submit-btn {
            width: 100%;
            height: 56px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            border: none;
            border-radius: 15px;
            background: linear-gradient(100deg,#9184e9,#7163d3);
            color: white;
            font: inherit;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 12px 25px rgba(113,99,211,.23);
            transition: .2s ease;
        }

            .submit-btn:hover {
                transform: translateY(-2px);
            }

            .submit-btn:disabled {
                opacity: .7;
                cursor: wait;
            }

        .secure-note {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 21px;
            color: #959ab0;
            font-size: 12px;
            text-align: center;
        }

            .secure-note i {
                color: #4dbb9e;
            }

        .back-section {
            margin-top: 33px;
            padding-top: 27px;
            border-top: 1px solid #ececf5;
            text-align: center;
        }

        .back-link {
            color: var(--primary);
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
        }

        .validation-summary,
        .field-error {
            color: #d94b70;
            font-size: 12px;
        }

            .validation-summary ul {
                margin-bottom: 16px;
                padding-left: 20px;
            }

        .field-error {
            display: block;
            margin-top: 7px;
        }

        @@media(max-width: 960px) {
            .auth-card {
                grid-template-columns: 42% 58%;
            }

            .brand-side {
                padding: 38px 28px;
            }

            .form-side {
                padding: 40px 35px;
            }
        }

        @@media(max-width: 720px) {
            .auth-page {
                padding: 18px 12px;
            }

            .auth-card {
                grid-template-columns: 1fr;
                border-radius: 24px;
            }

            .brand-side {
                padding: 25px;
            }

            .brand-content {
                margin-top: 24px;
            }

                .brand-content h1 {
                    font-size: 26px;
                }

            .illustration,
            .brand-bottom {
                display: none;
            }

            .form-side {
                padding: 35px 25px 42px;
            }

            .form-header h2 {
                font-size: 30px;
            }
        }
    </style>
</head>

<body>

    <main class="auth-page">
        <div class="auth-card">

            <!-- SOL PANEL -->
            <aside class="brand-side">

                <div class="brand-logo">
                    <span class="logo-icon">
                        <i class="bi bi-envelope-paper-heart"></i>
                    </span>
                    <span>Mail<span class="accent">ora</span></span>
                </div>

                <div class="brand-content">

                    <div class="brand-pill">
                        <i class="bi bi-shield-lock"></i>
                        Güvenli hesap koruması
                    </div>

                    <h1>
                        Yeni bir başlangıç,
                        <span>daha güvenli bir hesap.</span>
                    </h1>

                    <p>
                        Yeni şifreni oluşturarak Mailora
                        hesabına güvenle erişmeye devam et.
                        Mesajların seni bekliyor!
                    </p>
                </div>

                <div class="illustration" aria-hidden="true">

                    <div class="shield-circle">
                        <i class="bi bi-shield-lock"></i>
                    </div>

                    <div class="floating-check">
                        <i class="bi bi-check-circle-fill"></i>
                        Hesabın güvende
                    </div>
                </div>

                <div class="brand-bottom">

                    <div class="brand-feature">
                        <div class="feature-icon">
                            <i class="bi bi-key"></i>
                        </div>
                        <div>
                            <strong>Güçlü şifre</strong>
                            <small>Hesabını daha iyi koru.</small>
                        </div>
                    </div>

                    <div class="brand-feature">
                        <div class="feature-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div>
                            <strong>Güvenli hesap</strong>
                            <small>Bilgilerin koruma altında.</small>
                        </div>
                    </div>

                    <div class="brand-feature">
                        <div class="feature-icon">
                            <i class="bi bi-envelope-check"></i>
                        </div>
                        <div>
                            <strong>Mailora deneyimi</strong>
                            <small>Mesajlarına kaldığın yerden devam et.</small>
                        </div>
                    </div>

                </div>
            </aside>

            <!-- SAĞ PANEL -->
            <section class="form-side">
                <div class="form-content">

                    <div class="reset-icon">
                        <i class="bi bi-key"></i>
                    </div>

                    <div class="form-header">
                        <h2>Yeni Şifre Oluştur</h2>
                        <p>
                            Hesabın için güçlü ve güvenli
                            bir şifre belirle.
                        </p>
                    </div>

                    <form asp-controller="PasswordChange"
                          asp-action="ResetPassword"
                          method="post"
                          class="reset-form"
                          id="resetForm">

                        @Html.AntiForgeryToken()

                        <!--
                        userId ve token hidden input olarak
                        tutulmuyor. Controller TempData
                        üzerinden bu bilgilere erişecek.
                    -->

                        <div asp-validation-summary="ModelOnly"
                             class="validation-summary"
                             role="alert"></div>

                        <!-- YENİ ŞİFRE -->
                        <div class="field">

                            <label asp-for="Password">
                                Yeni Şifre
                                <span class="required">*</span>
                            </label>

                            <div class="input-wrap">

                                <i class="bi bi-lock input-icon"></i>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-input"
                                       placeholder="Yeni şifrenizi girin"
                                       autocomplete="new-password"
                                       required />

                                <button type="button"
                                        class="eye-btn"
                                        data-toggle="Password"
                                        aria-label="Şifreyi göster"
                                        aria-pressed="false">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>

                            <span asp-validation-for="Password"
                                  class="field-error"></span>

                            <div class="strength-bars" id="strengthBars">
                                <span></span>
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>

                            <div class="strength-label">
                                <span>Şifre gücü</span>
                                <b id="strengthText">—</b>
                            </div>

                            <div class="password-rules">
                                <div id="ruleLength">
                                    <i class="bi bi-circle"></i>
                                    En az 8 karakter
                                </div>

                                <div id="ruleUpper">
                                    <i class="bi bi-circle"></i>
                                    Büyük harf
                                </div>

                                <div id="ruleLower">
                                    <i class="bi bi-circle"></i>
                                    Küçük harf
                                </div>

                                <div id="ruleNumber">
                                    <i class="bi bi-circle"></i>
                                    Rakam
                                </div>

                                <div id="ruleSpecial">
                                    <i class="bi bi-circle"></i>
                                    Özel karakter
                                </div>
                            </div>
                        </div>

                        <!-- ŞİFRE TEKRAR -->
                        <div class="field">

                            <label asp-for="ConfirmPassword">
                                Yeni Şifre Tekrar
                                <span class="required">*</span>
                            </label>

                            <div class="input-wrap">

                                <i class="bi bi-shield-lock input-icon"></i>

                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       class="form-input"
                                       placeholder="Şifrenizi tekrar girin"
                                       autocomplete="new-password"
                                       required />

                                <button type="button"
                                        class="eye-btn"
                                        data-toggle="ConfirmPassword"
                                        aria-label="Şifreyi göster"
                                        aria-pressed="false">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>

                            <span asp-validation-for="ConfirmPassword"
                                  class="field-error"></span>

                            <span id="matchText"
                                  class="match-text"
                                  aria-live="polite"></span>
                        </div>

                        <!-- GÜNCELLE -->
                        <button type="submit"
                                class="submit-btn"
                                id="submitBtn">

                            <span>Şifremi Güncelle</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>

                        <div class="secure-note">
                            <i class="bi bi-shield-check"></i>
                            Şifreniz güvenli şekilde güncellenir.
                        </div>
                    </form>

                    <div class="back-section">
                        <a asp-controller="Login"
                           asp-action="SignIn"
                           class="back-link">

                            <i class="bi bi-arrow-left"></i>
                            Giriş Sayfasına Dön
                        </a>
                    </div>

                </div>
            </section>

        </div>
    </main>

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const password = document.getElementById("Password");
            const confirmPassword =
                document.getElementById("ConfirmPassword");

            const strengthText =
                document.getElementById("strengthText");

            const bars =
                document.querySelectorAll("#strengthBars span");

            const matchText =
                document.getElementById("matchText");

            const form =
                document.getElementById("resetForm");

            const submitBtn =
                document.getElementById("submitBtn");

            // ŞİFRE GÖSTER/GİZLE
            document.querySelectorAll("[data-toggle]").forEach(btn => {

                btn.addEventListener("click", function() {

                    const input = document.getElementById(
                        this.dataset.toggle
                    );

                    const visible = input.type === "password";

                    input.type = visible ? "text" : "password";

                    this.innerHTML = visible
                        ? '<i class="bi bi-eye-slash"></i>'
                        : '<i class="bi bi-eye"></i>';

                    this.setAttribute(
                        "aria-label",
                        visible ? "Şifreyi gizle" : "Şifreyi göster"
                    );

                    this.setAttribute("aria-pressed", String(visible));
                });
            });

            // ŞİFRE KURALLARI
            function getRules(value) {
                return {
                    length: value.length >= 8,
                    upper: /[A-ZÇĞİÖŞÜ]/.test(value),
                    lower: /[a-zçğıöşü]/.test(value),
                    number: /[0-9]/.test(value),
                    special: /[^a-zA-ZçğıöşüÇĞİÖŞÜ0-9]/.test(value)
                };
            }

            function updateRule(id, valid) {

                const element = document.getElementById(id);

                element.classList.toggle("valid", valid);

                element.querySelector("i").className = valid
                    ? "bi bi-check-circle-fill"
                    : "bi bi-circle";
            }

            // ŞİFRE GÜCÜ
            function updateStrength() {

                const value = password.value;
                const rules = getRules(value);

                updateRule("ruleLength", rules.length);
                updateRule("ruleUpper", rules.upper);
                updateRule("ruleLower", rules.lower);
                updateRule("ruleNumber", rules.number);
                updateRule("ruleSpecial", rules.special);

                const score =
                    Object.values(rules).filter(Boolean).length;

                let level = 0;
                let label = "—";
                let color = "#ececf6";

                if (value.length > 0) {

                    if (score <= 2) {
                        level = 1;
                        label = "Zayıf";
                        color = "#ed7188";
                    }
                    else if (score === 3) {
                        level = 2;
                        label = "Orta";
                        color = "#f0b75c";
                    }
                    else if (score === 4) {
                        level = 3;
                        label = "İyi";
                        color = "#79bce5";
                    }
                    else {
                        level = 4;
                        label = "Güçlü";
                        color = "#4dbb9e";
                    }
                }

                bars.forEach((bar, index) => {
                    bar.style.background =
                        index < level ? color : "#ececf6";
                });

                strengthText.textContent = label;
                strengthText.style.color = color;

                checkMatch();
            }

            // ŞİFRE EŞLEŞMESİ
            function checkMatch() {

                if (!confirmPassword.value) {
                    matchText.textContent = "";
                    matchText.classList.remove("success");
                    return false;
                }

                if (password.value === confirmPassword.value) {

                    matchText.textContent = "✓ Şifreler eşleşiyor";
                    matchText.classList.add("success");

                    return true;
                }

                matchText.textContent = "Şifreler eşleşmiyor";
                matchText.classList.remove("success");

                return false;
            }

            password.addEventListener("input", updateStrength);
            confirmPassword.addEventListener("input", checkMatch);

            // FORM GÖNDERİMİ
            form.addEventListener("submit", function(event) {

                if (!checkMatch()) {
                    event.preventDefault();
                    confirmPassword.focus();
                    return;
                }

                if (!form.checkValidity()) return;

                setTimeout(function() {

                    if (event.defaultPrevented) return;

                    submitBtn.disabled = true;
                    submitBtn.innerHTML =
                        '<i class="bi bi-arrow-repeat"></i> Güncelleniyor...';

                }, 0);
            });

        });
    </script>

</body>
</html>
