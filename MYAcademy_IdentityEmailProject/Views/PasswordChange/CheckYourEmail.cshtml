@{
    Layout = null;
    ViewData["Title"] = "E-postanızı Kontrol Edin - Mailora";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family: 'DM Sans', sans-serif;
            background: linear-gradient( 125deg, #f0edff 0%, #fafbff 48%, #eaf3ff 100% );
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            color: #30334d;
        }

        .success-card {
            width: 100%;
            max-width: 560px;
            padding: 55px 42px;
            text-align: center;
            background: white;
            border-radius: 30px;
            box-shadow: 0 24px 80px rgba(68,61,131,.12);
        }

        .logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 42px;
        }

        .logo-icon {
            width: 48px;
            height: 48px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg,#a39af0,#7063ce);
            box-shadow: 0 9px 20px rgba(103,84,205,.23);
            color: white;
            font-size: 24px;
        }

        .logo-text {
            font-size: 27px;
            font-weight: 800;
            letter-spacing: -1px;
        }

            .logo-text span {
                color: #8274df;
            }

        .success-icon {
            width: 110px;
            height: 110px;
            margin: 0 auto 30px;
            border-radius: 50%;
            background: #f1eeff;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #8174df;
            font-size: 49px;
        }

        h1 {
            font-size: 31px;
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 17px;
        }

        .description {
            color: #858aa2;
            font-size: 15px;
            line-height: 1.9;
            margin-bottom: 27px;
        }

        .info-box {
            background: #f6f4ff;
            border: 1px solid #e8e3ff;
            border-radius: 15px;
            padding: 17px;
            color: #7669d4;
            font-size: 13px;
            line-height: 1.7;
            margin-bottom: 30px;
        }

            .info-box i {
                margin-right: 6px;
            }

        .login-btn {
            width: 100%;
            min-height: 55px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 11px;
            background: linear-gradient(100deg,#9184e9,#7163d3);
            color: white;
            text-decoration: none;
            font-size: 15px;
            font-weight: 700;
            border-radius: 15px;
            box-shadow: 0 12px 25px rgba(113,99,211,.23);
            transition: .2s ease;
        }

            .login-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 16px 30px rgba(113,99,211,.30);
            }

        .footer-note {
            margin-top: 25px;
            font-size: 12px;
            color: #959ab0;
        }

        @@media(max-width: 600px) {
            .success-card {
                padding: 38px 23px;
            }

            h1 {
                font-size: 25px;
            }
        }
    </style>
</head>

<body>

    <main class="success-card">

        <div class="logo">
            <div class="logo-icon">
                <i class="bi bi-envelope-paper-heart"></i>
            </div>

            <div class="logo-text">
                Mail<span>ora</span>
            </div>
        </div>

        <div class="success-icon">
            <i class="bi bi-envelope-check"></i>
        </div>

        <h1>E-postanızı Kontrol Edin!</h1>

        <p class="description">
            Hesabınızla eşleşen bir e-posta adresi varsa
            şifre sıfırlama bağlantısını gönderdik.
            <br />
            <strong>Gelen kutunuzu ve spam klasörünüzü kontrol edin.</strong>
        </p>

        <div class="info-box">
            <i class="bi bi-info-circle"></i>
            E-postadaki bağlantıya tıklayarak
            yeni şifrenizi güvenle oluşturabilirsiniz.
        </div>

        <a asp-controller="Login"
           asp-action="SignIn"
           class="login-btn">
            <i class="bi bi-arrow-left"></i>
            Giriş Sayfasına Dön
        </a>

        <div class="footer-note">
            <i class="bi bi-shield-check"></i>
            Mailora Güvenli Hesap Kurtarma
        </div>

    </main>

</body>
</html>
